#!/bin/bash
# source.me - Setup venv and install Ansible for PI-Routes repo
# Usage: source source.me
#
# Prerequisites: python3, pip (system packages)

set -e

VENV_DIR=".venv"
REPO_DIR="$(cd "$(dirname "$0")" && pwd)"

# Create venv if it doesn't exist
if [ ! -d "$VENV_DIR" ]; then
    echo "[source.me] Creating virtualenv in $VENV_DIR..."
    python3 -m venv "$VENV_DIR"
fi

# Activate venv
echo "[source.me] Activating venv..."
# shellcheck disable=SC1091
source "$VENV_DIR/bin/activate"

# Upgrade pip, then install requirements
if [ -f "$REPO_DIR/requirements.txt" ]; then
    echo "[source.me] Installing requirements from requirements.txt..."
    pip install --quiet -r "$REPO_DIR/requirements.txt"
else
    echo "[source.me] No requirements.txt found. Installing ansible package..."
    pip install --quiet ansible
fi

# Verify SSH key exists
SSH_KEY="$HOME/.ssh/id_ed25519"
if [ ! -f "$SSH_KEY" ]; then
    echo "[source.me] WARNING: SSH key $SSH_KEY not found!"
    echo "[source.me] Make sure you have key-based access to 192.168.2.1"
    echo "[source.me] Generate one with: ssh-keygen -t ed25519"
    echo "[source.me] Deploy it to the R6S: ssh-copy-id -i $SSH_KEY.pub root@192.168.2.1"
else
    echo "[source.me] SSH key $SSH_KEY found."
fi

echo ""
echo "[source.me] Ready. Run: ansible-playbook -i inventory/inventory.yml playbook.yml"
